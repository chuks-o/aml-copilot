{
  "name": "aml-copilot-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "codegen": "openapi-typescript ../backend/openapi.yaml --output src/generated/cases-api.ts && graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "graphql": "^17.0.2",
    "next": "^16.4.1",
    "openapi-fetch": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "7.4.3",
    "@graphql-codegen/typed-document-node": "7.1.1",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.9",
    "@graphql-codegen/typescript-resolvers": "6.1.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@jest/globals": "30.5.2",
    "@redocly/cli": "2.57.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.1",
    "expect-type": "1.4.0",
    "globals": "^17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "ts-jest": "29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
