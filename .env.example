# Copy to .env at the repo root and fill in. .env is git-ignored.
# Backend commands read it from the repo root or from backend/.

# Kaggle → Settings → API → Generate New Token
KAGGLE_API_TOKEN=

# Backend (aml.common.config.Settings)
AML_ENV=local
AML_LOG_LEVEL=INFO
AML_API_HOST=127.0.0.1
AML_API_PORT=8000

# Web
NEXT_PUBLIC_GRAPHQL_URL=/api/graphql
