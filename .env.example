# Copy to .env at the repo root (cp .env.example .env). .env is git-ignored.
# Read by backend commands (from the root or backend/) and by every container
# in infra/docker-compose.yml. Values below are for local development only.

# Kaggle, for `make download`. Kaggle → Settings → API → Generate New Token, then set
# KAGGLE_API_TOKEN. The kaggle library also accepts KAGGLE_USERNAME + KAGGLE_KEY, or
# ~/.kaggle/access_token / ~/.kaggle/kaggle.json, if you prefer those.
KAGGLE_API_TOKEN=

# Postgres: read by the postgres image AND by aml settings
POSTGRES_USER=aml
POSTGRES_PASSWORD=aml-local-dev
POSTGRES_DB=aml

# RabbitMQ: read by the rabbitmq image AND by aml settings
RABBITMQ_DEFAULT_USER=aml
RABBITMQ_DEFAULT_PASS=aml-local-dev

# Backend (aml.common.config.Settings). Hosts are for commands run on your
# machine; docker-compose.yml overrides them to postgres / rabbitmq.
AML_ENV=local
AML_LOG_LEVEL=INFO
AML_API_HOST=127.0.0.1
AML_API_PORT=8000
# Where clients (aml.clients, the web BFF) reach the API
AML_CASES_API_URL=http://127.0.0.1:8000
AML_POSTGRES_HOST=localhost
AML_POSTGRES_PORT=5432
AML_RABBITMQ_HOST=localhost
AML_RABBITMQ_PORT=5672

# Web (inlined at build time)
NEXT_PUBLIC_GRAPHQL_URL=/api/graphql
